{
  "name": "@webwriter/quiz-vue",
  "version": "1.0.0",
  "description": "A true-or-false quiz widget built with Vue from the widget tutorial.",
  "keywords": [
    "webwriter-widget",
    "widget-practical",
    "widget-lang-en"
  ],
  "exports": {
    "./widgets/ww-quiz.js": "./dist/ww-quiz.js",
    "./snippets/quiz.html": "./quiz.html",
    "./tests/quiz.js": "./quiz-tests.js"
  },
  "editingConfig": {
    "./widgets/ww-quiz": {
      "label": "Quiz",
      "content": "p+",
      "sharedData": true
    },
    "./snippets/quiz": {
      "label": "Quiz with question"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.44",
    "esbuild-wasm": "^0.25.12"
  },
  "files": [
    "dist/ww-quiz.js",
    "quiz.html",
    "quiz-tests.js"
  ]
}
