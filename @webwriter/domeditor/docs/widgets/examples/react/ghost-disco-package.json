    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "files": [
    "dist/ww-ghost-disco.js",
    "ghost-disco.html",
    "ghost-disco-tests.js"
  ],
  "scripts": {
    "build": "node build.mjs ghost-disco"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.12"
  }
