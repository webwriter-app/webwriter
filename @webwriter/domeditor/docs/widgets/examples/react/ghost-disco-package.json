{
  "name": "@example/ghost-disco-react",
  "version": "1.0.0",
  "description": "A Ghost Disco widget built with React from the widget tutorial.",
  "keywords": [
    "webwriter-widget",
    "widget-practical",
    "widget-lang-en"
  ],
  "exports": {
    "./widgets/ww-ghost-disco.js": "./dist/ww-ghost-disco.js",
