{
  "name": "@webwriter/quiz-angular",
  "version": "1.0.0",
  "description": "A true-or-false quiz widget built with Angular Elements.",
  "keywords": [
    "webwriter-widget",
    "widget-practical",
    "widget-lang-en"
  ],
  "exports": {
    "./widgets/ww-quiz.js": "./dist/ww-quiz.js",
    "./widgets/ww-hello.js": "./dist/ww-hello.js",
    "./snippets/quiz.html": "./quiz.html",
    "./tests/quiz.js": "./quiz-tests.js"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "editingConfig": {
    "./widgets/ww-quiz": {
      "label": "Quiz",
      "content": "p+",
      "sharedData": true
    },
    "./snippets/quiz": {
      "label": "Quiz with question"
    }
  },
  "dependencies": {
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/elements": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "rxjs": "^7.8.2",
    "@angular/common": "^22.2.2"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.12"
  },
  "files": [
    "dist/ww-quiz.js",
    "dist/ww-hello.js",
    "*.ts",
    "quiz.html",
    "quiz-tests.js"
  ]
}
