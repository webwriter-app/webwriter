{
  "name": "@example/ghost-disco-angular",
  "version": "1.0.0",
  "description": "An interactive ghost dance party widget.",
  "keywords": [
    "webwriter-widget",
    "widget-practical",
    "widget-lang-en"
  ],
  "exports": {
    "./widgets/ww-ghost-disco.js": "./dist/ww-ghost-disco.js",
    "./snippets/ghost-disco.html": "./ghost-disco.html",
    "./tests/ghost-disco.js": "./ghost-disco-tests.js"
  },
  "scripts": {
    "build": "node build.mjs ghost-disco"
  },
  "editingConfig": {
    "./widgets/ww-ghost-disco": {
      "label": "Ghost Disco",
