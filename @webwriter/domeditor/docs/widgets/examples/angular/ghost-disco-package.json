    },
    "./snippets/ghost-disco": {
      "label": "Ghost Disco with invitation"
    }
  },
  "dependencies": {
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/elements": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "rxjs": "^7.8.2",
    "@angular/common": "^22.2.2"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.12"
  },
  "files": [
    "dist/ww-ghost-disco.js",
    "ghost-disco.html",
    "ghost-disco-tests.js"
  ]
}
