# Copy to .env.private-testing in the DOMEditor directory (ignored by Git).
# Required: the dedicated server's VPN address. Never use 0.0.0.0 or ::.
WEBWRITER_VPN_IP=100.100.100.10
# Two distinct DNS names resolving to that VPN IP; no scheme, port, or path.
WEBWRITER_APP_HOST=authors.vpn.example
WEBWRITER_EDITOR_HOST=content.vpn.example
WEBWRITER_HTTPS_PORT=443
# Absolute directory with fullchain.pem and privkey.pem valid for both names.
WEBWRITER_TLS_DIR=/etc/webwriter-private/tls
