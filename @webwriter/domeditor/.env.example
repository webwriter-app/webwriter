# Optional. Providers can also be configured in the app or at /admin.
OPENAI_API_KEY=

# The development server refuses non-loopback hosts.
WEBWRITER_DEV_HOST=127.0.0.1
WEBWRITER_DEV_PORT=1234

# Only for npm run start:private on a dedicated VPN-only test host.
# Build with these same two distinct HTTPS origins; see dev-server/PRIVATE-TESTING.md.
# VITE_APP_ORIGIN=https://authors.vpn.example
# VITE_EDITOR_ORIGIN=https://content.vpn.example
# WEBWRITER_DEV_DATA_DIR=/srv/webwriter-private/data
