{
  "checks": [
    {
      "name": "binary incremental updates, reload and batched writes"
    },
    {
      "name": "legacy migration commits before removing the legacy key"
    },
    {
      "name": "a remaining legacy snapshot merges with already committed IndexedDB edits"
    },
    {
      "name": "aborted migration preserves legacy data and retries readiness"
    },
    {
      "name": "failed multi-scope writes abort atomically and retain updates for retry"
    },
    {
      "name": "an unreadable scope does not block committed writes in other scopes"
    },
    {
      "name": "an explicitly failed flush retries automatically"
    },
    {
      "name": "compaction preserves concurrent writers and replay is bounded"
    },
    {
      "name": "aborted compaction leaves the old checkpoint and log recoverable"
    },
    {
      "name": "large incremental values compact by byte size before the record limit"
    },
    {
      "name": "writes arriving during a transaction survive its acknowledgement"
    },
    {
      "name": "teardown drains captured updates without retaining live listeners"
    },
    {
      "name": "widget integration restores scopes and excludes participant data from exports"
    },
    {
      "name": "offline scopes isolate users, documents and sharing modes"
    },
    {
      "name": "paced IndexedDB persistence drains without an accumulating write backlog"
    }
