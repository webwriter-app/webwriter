{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["de"],
  "tsConfig": "./tsconfig.localize.json",
  "output": {
    "mode": "runtime",
    "outputDir": "./localization/generated",
    "localeCodesModule": "./localization/generated/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./localization"
  }
}
