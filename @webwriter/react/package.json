      "types": "./viewport.d.ts",
      "default": "./viewport.js"
    },
    "./help": {
      "types": "./help.d.ts",
      "default": "./help.js"
    },
    "./print": {
      "types": "./print.d.ts",
      "default": "./print.js"
    },
    "./scene": {
      "types": "./scene.d.ts",
      "default": "./scene.js"
    },
    "./settings": {
      "types": "./settings.d.ts",
      "default": "./settings.js"
    },
    "./shortcuts": {
      "types": "./shortcuts.d.ts",
      "default": "./shortcuts.js"
    },
    "./playback": {
      "types": "./playback.d.ts",
