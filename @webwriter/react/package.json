    "drag.js",
    "drag.d.ts",
    "viewport.js",
    "viewport.d.ts",
    "help.js",
    "help.d.ts",
    "print.js",
    "print.d.ts",
    "scene.js",
    "scene.d.ts",
    "settings.js",
    "settings.d.ts",
    "shortcuts.js",
    "shortcuts.d.ts",
    "playback.js",
    "playback.d.ts",
    "data.js",
