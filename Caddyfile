(static) {
	root * /srv
	encode zstd gzip
	file_server

	# Never cache the service worker or HTML entry points, otherwise clients get stuck on old versions
	@nocache path / /index.html /frame-shell.html /local-package-service-worker.js
	header @nocache Cache-Control "no-cache"
}

# Serves both the app origin and the editor frame origin; they share the same static files.
:80 {
	# Liveness probe for Docker / Coolify
	handle /health {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# Basic auth, generated by caddy-entrypoint.sh (empty unless BASIC_USER and BASIC_PASS are set)
	import /etc/caddy/auth.caddy

	import static
}

# Container-internal listener for the health check, bypasses basic auth
:8099 {
	bind 127.0.0.1
	import static
}
