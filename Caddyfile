(static) {
	root * /srv
	encode zstd gzip
	# Deployment settings, read by the app before its modules (src/runtime-config.ts). The values
	# come from the container environment and are checked by caddy-entrypoint.sh, so one image
	# serves staging and production side by side. Empty values fall back to the build-time ones.
	handle /runtime-config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `globalThis.webwriterRuntimeConfig = {"appOrigin": "{$APP_ORIGIN}", "editorOrigin": "{$EDITOR_ORIGIN}", "edumixURL": "{$EDUMIX_URL}"}
` 200
	}
	redir /gallery /packages/ 308
	redir /gallery/ /packages/ 308
	@packagePreview path_regexp packagePreview ^/packages/@[a-z0-9_][a-z0-9._-]*/[a-z0-9_][a-z0-9._-]*/?$
	rewrite @packagePreview /packages/index.html
	file_server

	# Never cache the service worker or HTML entry points, otherwise clients get stuck on old versions
	@nocache path / /index.html /packages/ /packages/index.html /frame-shell.html /local-package-service-worker.js
	header @nocache Cache-Control "no-cache"
}

# Serves both the app origin and the editor frame origin; they share the same static files.
# HTTP_PORT: 80 by default (Docker/Coolify); Kubernetes runs as non-root on 8080.
:{$HTTP_PORT:80} {
	# Liveness probe for Docker / Coolify
	handle /health {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# Basic auth, generated by caddy-entrypoint.sh (empty unless BASIC_USER and BASIC_PASS are set).
	# CADDY_AUTH_FILE moves it to a writable path when the root filesystem is read-only.
	import {$CADDY_AUTH_FILE:/etc/caddy/auth.caddy}

	import static
}

# Container-internal listener for the health check, bypasses basic auth
:8099 {
	bind 127.0.0.1
	import static
}
