# Serves both the app origin and the editor frame origin; they share the same static files.
:80 {
	# Liveness probe for Docker / Coolify
	handle /health {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	root * /srv
	encode zstd gzip
	file_server

	# Never cache the service worker or HTML entry points, otherwise clients get stuck on old versions
	@nocache path / /index.html /frame-shell.html /local-package-service-worker.js
	header @nocache Cache-Control "no-cache"
}
